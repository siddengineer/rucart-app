<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <!-- Top Back Bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/btnRegisterBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="4dp"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Create Account"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Branding Subheading -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_rucart_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.04"
                android:text="Join RUCART"
                android:textColor="@color/primary_green"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get fresh groceries delivered in 10-15 minutes"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Full Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="Full Name *"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRegName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_field"
            android:hint="e.g. Rahul Sharma"
            android:inputType="textPersonName"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body" />

        <!-- Phone Number -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="Mobile Number (10 digits) *"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_medium">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+91"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="@dimen/spacing_small"
                android:background="@color/divider_color" />

            <EditText
                android:id="@+id/etRegPhone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="9876543210"
                android:inputType="phone"
                android:maxLength="10"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="Email Address (Optional)"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRegEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_field"
            android:hint="e.g. rahul@example.com"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body" />

        <!-- Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="Password (min 6 characters) *"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_medium">

            <EditText
                android:id="@+id/etRegPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Enter secure password"
                android:inputType="textPassword"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <ImageView
                android:id="@+id/ivRegTogglePassword"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle password"
                android:padding="4dp"
                android:src="@drawable/ic_visibility"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Confirm Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="Confirm Password *"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_medium">

            <EditText
                android:id="@+id/etRegConfirmPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Re-enter password"
                android:inputType="textPassword"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <ImageView
                android:id="@+id/ivRegToggleConfirmPassword"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle password"
                android:padding="4dp"
                android:src="@drawable/ic_visibility"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Delivery Area Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="Delivery Area (Pune) *"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerArea"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="@dimen/spacing_medium" />

        <!-- Address Line -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="Flat / House No. / Society / Street *"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRegAddress"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_field"
            android:hint="e.g. Flat 402, Green Avenue, Lane 3"
            android:inputType="textPostalAddress"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body" />

        <!-- Register Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegisterSubmit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/spacing_large"
            android:background="@drawable/bg_button_primary"
            android:text="Create Account &amp; Shop"
            android:textColor="@color/white"
            android:textSize="@dimen/text_subheading"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pbRegister"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/spacing_medium"
            android:indeterminateTint="@color/primary_green"
            android:visibility="gone" />

        <!-- Back to Login -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvBackToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:text="Login"
                android:textColor="@color/primary_green"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Terms notice -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/terms_notice"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption" />

    </LinearLayout>
</ScrollView>
