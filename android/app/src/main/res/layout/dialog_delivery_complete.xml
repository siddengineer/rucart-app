<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvCompleteDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="Confirm Delivery Handover"
        android:textColor="@color/colorTextPrimary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvCompleteCashReminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_banner_green"
        android:fontFamily="sans-serif-bold"
        android:padding="12dp"
        android:text="💵 COD: Ensure you have collected ₹ 0.00 from the customer."
        android:textColor="@color/colorPrimaryDark"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="Delivery Notes (Optional):"
        android:textColor="@color/colorTextPrimary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etDeliveryCompletionNotes"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_edit_text"
        android:gravity="top|start"
        android:hint="e.g. Handed to customer at door, package sealed"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextHint"
        android:textSize="13sp" />

</LinearLayout>
