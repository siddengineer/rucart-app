        <!-- Order Success Screen -->
        <activity
            android:name=".ui.customer.OrderSuccessActivity"
            android:exported="false"
            android:label="Order Confirmed" />

        <!-- Payment Processing Screen -->
        <activity
            android:name=".ui.customer.PaymentProcessingActivity"
            android:exported="false"
            android:label="Payment Processing" />

        <!-- Payment Result Screen (Success / Failed / COD) -->
        <activity
            android:name=".ui.customer.PaymentResultActivity"
            android:exported="false"
            android:label="Payment Status" />

        <!-- Transaction History Screen -->
        <activity
            android:name=".ui.customer.TransactionHistoryActivity"
            android:exported="false"
            android:label="Transaction History" />

        <!-- Refund Status Screen -->
        <activity
            android:name=".ui.customer.RefundStatusActivity"
            android:exported="false"
            android:label="Refund Details" />

        <!-- Receipt Viewer Screen -->
        <activity
            android:name=".ui.customer.ReceiptViewActivity"
            android:exported="false"
            android:label="Tax Invoice &amp; Receipt" />

        <!-- Notifications Screen -->
        <activity
            android:name=".ui.customer.NotificationsActivity"
            android:exported="false"
            android:label="Notifications" />

        <!-- FileProvider for Sharing and Viewing PDF Receipts -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

