<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:name=".RucartApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rucart"
        android:usesCleartextTraffic="true">

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyDfCp5QHI7_cHl8Kdi3bSOTHcB_A4ZTHk4" />

        <!-- Splash Activity (Entry Point) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Rucart.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Role Selection Screen -->
        <activity
            android:name=".ui.auth.RoleSelectionActivity"
            android:exported="true"
            android:label="@string/select_role" />

        <!-- Login Screen -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:label="@string/login_title" />

        <!-- Register Screen -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:label="Register Account" />

        <!-- MSG91 OTP Verification Screen -->
        <activity
            android:name=".ui.auth.Msg91OtpActivity"
            android:exported="false"
            android:label="Verify OTP" />

        <!-- Product Detail Screen -->
        <activity
            android:name=".ui.customer.ProductDetailActivity"
            android:exported="false"
            android:label="Product Details" />

        <!-- Address Management Screen -->
        <activity
            android:name=".ui.customer.AddressManagementActivity"
            android:exported="false"
            android:label="Delivery Addresses" />

        <!-- Add Address Screen -->
        <activity
            android:name=".ui.customer.AddAddressActivity"
            android:exported="false"
            android:label="Add Address" />

        <!-- Checkout Screen -->
        <activity
            android:name=".ui.customer.CheckoutActivity"
            android:exported="false"
            android:label="Checkout" />

        <!-- Order Detail & Receipt Screen -->
        <activity
            android:name=".ui.customer.OrderDetailActivity"
            android:exported="false"
            android:label="Order Details" />

        <!-- Store Selection Screen -->
        <activity
            android:name=".ui.customer.StoreSelectionActivity"
            android:exported="false"
